{
  "folder": "register/commitments",
  "folder_per_year": true,
  "identifier_prefix": "C",
  "fields": {
    "status": { "type": "text", "allowed": ["open", "done", "dropped", "superseded"], "default": "open" },
    "subject": { "type": "text", "required": true },
    "date_of_fact": { "type": "date", "required": true },
    "owner": { "type": "text" },
    "owed_to": { "type": "text" },
    "due_date": { "type": "date" },
    "estimated_effort": { "type": "days" },
    "task_kind": { "type": "text", "allowed_from": "task_kinds" },
    "estimate_reason": { "type": "text" },
    "started_on": { "type": "date" },
    "started_sign": { "type": "text" },
    "real_effort": { "type": "days" },
    "optional": { "type": "boolean" }
  }
}
