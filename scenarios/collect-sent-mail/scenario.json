{
  "routine": "collect",
  "prompt": "Collect. I accept the proposal as your preview will show it: apply it without asking me again.",
  "expect": [
    { "record": "C-{year}-002", "field": "subject", "is": "payments-api-contribution" },
    { "record": "C-{year}-002", "field": "owner", "is": "the PO" },
    { "record": "C-{year}-002", "field": "owed_to", "is": "the head of payments" },
    { "record": "C-{year}-002", "field": "due_date", "is": "2026-03-20" },
    { "record": "C-{year}-002", "field": "source.where", "is": "exports/mail/sent/scope of our contribution.txt" },
    { "records": "commitments", "count": 2 },
    { "file": "state/last-collect.json", "field": "sources.mail.items", "is": 1 },
    { "file": "state/proposal.json", "absent": true }
  ]
}
