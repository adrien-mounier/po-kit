    "subject": { "type": "text", "required": true },
    "metric": { "type": "text", "required": true },
    "unit": { "type": "text" },
    "baseline": { "type": "number" },
    "target": { "type": "number" },
    "owner": { "type": "text" },
    "current_value": { "type": "number" },
    "measured_on": { "type": "date" }
  }
}
